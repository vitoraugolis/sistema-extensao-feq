      "formatoAulasResumo": "Aulas online ao vivo + gravadas",
      "formatoAulasDetalhe": "Aulas teóricas gravadas liberadas às segundas e aulas práticas online ao vivo às quartas, sempre das 19h30 às 22h30.",
      "professorResponsavel": "Flavio Vasconcelos da Silva",
      "professoresAdicionais": [
        "Claudio Vieira Neto",
