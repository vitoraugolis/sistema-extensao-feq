      "planoPagamento": { "@type": "feq:PlanoPagamento", "taxaInscricao": "69.00", "numParcelas": 15, "valorParcela": "1115.96", "aVista": "16739.36" },
      "urlExtecamp": "https://ins.extecamp.unicamp.br/curso/dados/FEQ-0360/006",
      "objetivo": "Capacitar o aluno na gestão de processos industriais, integrando segurança, confiabilidade e otimização, para se tornar referência na área — com autonomia para formular estratégias e implementar as melhores práticas de mercado.",
      "conteudoProgramatico": "(1) Liderança de Pessoas em Ambientes Industriais; (2) Comportamento Humano: Segurança de Processos e Confiabilidade Industrial; (3) Processos Industriais; (4) Confiabilidade Operacional; (5) Gestão de Manutenção e Inspeção de Equipamentos; (6) Técnicas de Otimização Aplicadas à Confiabilidade; (7) Análise Econômica para Gestão de Confiabilidade; (8) Técnicas de Análise de Risco; (9) Segurança Operacional; (10) Programa de Gerenciamento de Resíduos; (11) Tratamentos Convencionais e Não Convencionais; (12) Sistemas de Disposição Final; (13) Trabalho de Final de Curso (Monografia). Professores: Leonardo Fregolente, Fabio Marcelo Brogna (Petrobras), Angela Hayashi.",
      "insightVenda": "Queixas de preço amenizadas com webinar + descontos; testar anúncios de urgência.",
      "wasDerivedFrom": "feq:fonteNotion"
    },
    {
