      "urlExtecamp": "https://ins.extecamp.unicamp.br/curso/inscricao/FEQ-0333/001",
      "objetivo": "Compreender captura, utilização e armazenamento de carbono (CCUS) e seu papel na mitigação climática e na descarbonização: dominar a cadeia de valor (captura-transporte-utilização-armazenamento de CO₂), tecnologias de captura e aplicações comerciais, o cenário global e brasileiro, e políticas públicas/mercados de carbono. Desenvolve pensamento crítico sobre o tema. Ministrado EM INGLÊS.",
      "conteudoProgramatico": "8 módulos: (1) Mudanças Climáticas e o Papel do CCUS — Acordo de Paris, metas net-zero, por que reduzir emissões não basta; (2) O que é CCUS? — definição, CCS vs CCUS, história da tecnologia; (3) A Cadeia de Valor do CCUS — captura de CO₂ (fontes e tecnologias), transporte (modais e infraestrutura, realidade brasileira), utilização (aplicações comerciais e pesquisas) e armazenamento (geológico, mineralização; potencial do Brasil); (4) Panorama Global do CCUS — projetos em operação/desenvolvimento, países líderes, hubs; (5) Desafios Técnicos do CCUS — principais barreiras no Brasil; (6) CCUS no Brasil — perfil de emissões, prioridades de descarbonização, licenciamento e percepção pública; (7) Desafios e Oportunidades — barreiras técnicas, econômicas, regulatórias e sociais, e oportunidades de inovação e investimento; (8) CCUS e Políticas Públicas — incentivos internacionais, créditos de carbono, mercados voluntários.",
      "insightVenda": "Aulas ministradas EM INGLÊS. São módulos (Module 1), não curso pela metade. Primeiro oferecimento. Início 01/08/2026 (1º encontro presencial na FEQ, Campinas), término 19/12/2026.",
      "wasDerivedFrom": "feq:fonteNotion",
      "salarioRef": "R$ 12.500,00 — referência de mercado para especialistas em CCUS",
      "empresasJson": "[\"EMS\", \"Solvay\", \"3M\", \"Petrobras\", \"Eaton\", \"Buckman\", \"Boehringer\", \"Braskem\"]",
      "avaliacaoTexto": "Frequência atestada pela entrega de atividades.",
      "objetivosJson": "[{\"t\": \"Fundamentos de CCUS\", \"d\": \"Apresentar os conceitos fundamentais sobre captura, utilização e armazenamento de carbono, sua relevância para a mitigação das mudanças climáticas e seu papel nas estratégias de descarbonização.\"}, {\"t\": \"Pensamento crítico\", \"d\": \"Desenvolver habilidades e pensamento crítico sobre as principais tecnologias, o cenário global e brasileiro, e as políticas públicas e mercados de carbono.\"}]",
      "habilidadesJson": "[\"Mudanças climáticas e metas net-zero\", \"Cadeia de valor do CCUS (captura, transporte, utilização, armazenamento)\", \"Tecnologias de captura e aplicações comerciais\", \"Panorama global de projetos e hubs\", \"Desafios técnicos, econômicos e regulatórios\", \"Oportunidades de inovação e investimento\", \"Políticas públicas, incentivos e mercados de carbono\", \"CCUS no contexto brasileiro\"]",
      "programaDetalheJson": "[{\"t\": \"Mudanças Climáticas e o Papel do CCUS\", \"s\": [\"Crise climática e metas do Acordo de Paris\", \"Por que só reduzir emissões não basta\", \"CCUS nas trajetórias de neutralidade de carbono (net-zero)\"]}, {\"t\": \"O que é CCUS?\", \"s\": [\"Definição e escopo\", \"Diferença entre CCS e CCUS\", \"História e evolução da tecnologia\"]}, {\"t\": \"A Cadeia de Valor do CCUS\", \"s\": [\"Captura de CO₂: fontes e tecnologias\", \"Transporte: modais, infraestrutura e a malha brasileira\", \"Utilização: aplicações comerciais e pesquisas\", \"Armazenamento: geológico, mineralização e potencial do Brasil\"]}, {\"t\": \"Panorama Global do CCUS\", \"s\": [\"Projetos em operação e em desenvolvimento\", \"Países líderes e setores envolvidos\", \"Iniciativas multilaterais e hubs\"]}, {\"t\": \"Desafios Técnicos do CCUS\", \"s\": [\"Principais barreiras técnicas para a adoção no Brasil\"]}, {\"t\": \"CCUS no Brasil\", \"s\": [\"Perfil de emissões e prioridades de descarbonização\", \"Percepção pública e licenciamento\", \"Papel do sistema nacional de inovação\"]}, {\"t\": \"Desafios e Oportunidades\", \"s\": [\"Barreiras técnicas, econômicas, regulatórias e sociais\", \"Oportunidades de inovação e investimento\", \"CCUS como indutor do desenvolvimento sustentável\", \"Desigualdades regionais\"]}, {\"t\": \"CCUS e Políticas Públicas\", \"s\": [\"Políticas e incentivos internacionais\", \"Créditos tributários, mercados voluntários e regulamentações\"]}]"
