      "urlExtecamp": "https://ins.extecamp.unicamp.br/curso/inscricao/FEQ-0360/007",
      "objetivo": "Capacitar o aluno na gestão de processos industriais, integrando segurança, confiabilidade e otimização, para se tornar referência na área — com autonomia para formular estratégias e implementar as melhores práticas de mercado.",
      "conteudoProgramatico": "(1) Liderança de Pessoas em Ambientes Industriais; (2) Comportamento Humano: Segurança de Processos e Confiabilidade Industrial; (3) Processos Industriais; (4) Confiabilidade Operacional; (5) Gestão de Manutenção e Inspeção de Equipamentos; (6) Técnicas de Otimização Aplicadas à Confiabilidade; (7) Análise Econômica para Gestão de Confiabilidade; (8) Técnicas de Análise de Risco; (9) Segurança Operacional; (10) Programa de Gerenciamento de Resíduos; (11) Tratamentos Convencionais e Não Convencionais; (12) Sistemas de Disposição Final; (13) Trabalho de Final de Curso (Monografia). Professores: Leonardo Fregolente, Fabio Marcelo Brogna (Petrobras), Angela Hayashi.",
      "insightVenda": "Queixas de preço amenizadas com webinar + descontos; testar anúncios de urgência.",
      "wasDerivedFrom": "feq:fonteNotion",
      "descontos": "Alunos e ex-alunos Unicamp/Extecamp têm 10% de desconto.",
      "plataformaAula": "Google Classroom",
      "salarioRef": "R$ 15.883,00 — Glassdoor, Engenheiro de Segurança de Processos",
      "professoresAdicionais": [
        "Fabio Marcelo Brogna",
        "Angela Hayashi"
      ],
      "empresasJson": "[\"EMS\", \"Solvay\", \"3M\", \"Petrobras\", \"Eaton\", \"Buckman\", \"Boehringer\", \"Braskem\"]",
      "avaliacaoTexto": "Frequência atestada pela entrega de atividades — presença ao vivo não é obrigatória. Turmas de no máximo 50 alunos; aulas gravadas na plataforma. Trabalho de Final de Curso (monografia) ao término.",
      "objetivosJson": "[{\"t\": \"Tornar os alunos referências\", \"d\": \"Capacitação na gestão integrada de segurança, confiabilidade e otimização de processos industriais, com autonomia estratégica e as ferramentas do mercado.\"}, {\"t\": \"Formação otimizada\", \"d\": \"Integração de fundamentos e prática em modelo de ensino a distância, com web-aulas ao vivo e conteúdos práticos e aprofundados.\"}]",
      "habilidadesJson": "[\"Liderança de pessoas em ambientes industriais\", \"Comportamento humano voltado à segurança de processo\", \"Confiabilidade operacional\", \"Manutenção e inspeção de equipamentos\", \"Técnicas de otimização em processos\", \"Análise econômica para decisões de confiabilidade\", \"Gestão de riscos e segurança operacional\", \"Gerenciamento de resíduos industriais\", \"Tratamentos convencionais e não convencionais\", \"Pesquisa aplicada (monografia)\"]",
      "depoimentosJson": "[{\"nome\": \"Juliana Panizza\", \"cargo\": \"Analista de Projetos Pleno\", \"texto\": \"Durante o emprego como técnica, fiz o curso da Extensão FEQ. Dois meses depois de terminar consegui um emprego como analista de projetos! Sinto que minha carreira de fato começou agora — trabalho numa empresa legal, com um salário bom e promessa de plano de carreira.\"}, {\"nome\": \"Edson Papassídero\", \"cargo\": \"Docente\", \"texto\": \"Tive a grata satisfação de ser aluno da Extensão FEQ Unicamp, onde encontrei Grandes Mestres e Grandes Profissionais. O curso superou minhas expectativas. Uma de minhas metas era me qualificar para a docência e em 2022 fui selecionado pelo SENAI.\"}]",
      "programaDetalheJson": "[{\"t\": \"Liderança de Pessoas em Ambientes Industriais\", \"s\": [\"Gestão de pessoas em rotinas operacionais\", \"Construção de equipe de alto desempenho\", \"Confiabilidade humana\", \"Casos de estudo em gestão de pessoas\"]}, {\"t\": \"Comportamento Humano: Segurança de Processos e Confiabilidade Industrial\", \"s\": [\"Cultura de segurança\", \"Confiabilidade humana: erros e falhas\", \"Comportamento de grupo\", \"Abordagens do erro humano (indivíduo × sistema)\"]}, {\"t\": \"Processos Industriais\", \"s\": [\"Tecnologias de processos químicos\", \"Equipamentos da indústria química\", \"Histórico de grandes acidentes\", \"Novas tendências em processos químicos\"]}, {\"t\": \"Confiabilidade Operacional\", \"s\": [\"Fundamentos da Engenharia de Confiabilidade\", \"HAZOP\", \"Análise de Camadas de Proteção (LOPA)\", \"Cálculos de Confiabilidade (SIL)\", \"Fatores humanos nos acidentes\", \"Gerenciamento de alarmes\"]}, {\"t\": \"Gestão de Manutenção e Inspeção de Equipamentos\", \"s\": [\"Estrutura organizacional da manutenção\", \"Manutenção e gestão de ativos\", \"Preventiva, sistemática, sob condição e corretiva\", \"Planejamento e criticidade\", \"Tecnologia 4.0 na manutenção e inspeção\"]}, {\"t\": \"Técnicas de Otimização Aplicadas à Confiabilidade\", \"s\": [\"Fundamentos de métodos de otimização\", \"Ferramentas de otimização\", \"Métodos matemáticos e estatísticos\"]}, {\"t\": \"Análise Econômica para Gestão de Confiabilidade\", \"s\": [\"Estimativa de custos de investimento e operacionais\", \"Matemática financeira\", \"Avaliação de lucratividade de alternativas\"]}, {\"t\": \"Técnicas de Análise de Risco\", \"s\": [\"Matriz de risco\", \"Checklist e 5 Porquês\", \"Análise preliminar de perigo\", \"Árvore de falhas\", \"HAZOP\", \"FMEA\"]}, {\"t\": \"Segurança Operacional\", \"s\": [\"Sistema de gestão de segurança operacional\", \"Gestão de mudanças\", \"Isolamento de energias\", \"Permissão de trabalho\", \"Plano de resposta a emergências\", \"Fatores humanos\"]}, {\"t\": \"Programa de Gerenciamento de Resíduos\", \"s\": [\"Gestão integrada\", \"Modelo de programa de gerenciamento\", \"Prevenção, controle e contenção\"]}, {\"t\": \"Tratamentos Convencionais e Não Convencionais\", \"s\": [\"Fontes geradoras de resíduos\", \"Tratamento de efluentes líquidos\", \"Tratamento de resíduos sólidos\", \"Confiabilidade nos sistemas de tratamento\"]}, {\"t\": \"Sistemas de Disposição Final\", \"s\": [\"Aterros sanitários e industriais\", \"Remediação de áreas contaminadas\", \"Confiabilidade na disposição final\"]}, {\"t\": \"Trabalho de Final de Curso (Monografia)\", \"s\": []}]"
    },
