      "planoPagamento": {
        "@type": "feq:PlanoPagamento",
        "taxaInscricao": "69.00",
        "numParcelas": 19,
        "valorParcela": "866.09",
        "aVista": "16455.75"
      },
      "urlExtecamp": "https://ins.extecamp.unicamp.br/curso/dados/FEQ-0480/009",
      "objetivo": "Qualificar profissionais para atuar em projetos de melhoria e inovação nas engenharias de processos usando ferramentas modernas de Inteligência Artificial: engenharia e simulação de processos, machine learning e deep learning, controle inteligente, análise de dados, otimização com algoritmos genéticos, lógica fuzzy e aprendizado por reforço.",
      "conteudoProgramatico": "(1) Engenharia de Processos e Inteligência Artificial; (2) Ferramentas Computacionais para IA (Python); (3) Ferramentas Estatísticas para Análise de Dados; (4) Análise e Simulação de Processos; (5) Técnicas de Otimização e Algoritmos Genéticos; (6) Machine Learning em Processos Industriais; (7) Modelagem e Suporte à Decisão Fuzzy; (8) Controle de Processos com Lógica Fuzzy; (9) Sistemas Neuro-Fuzzy; (10) Deep Learning em Processos Industriais; (11) Aprendizado por Reforço; (12) Processamento de Linguagem Natural (NLP); (13) Projetos Finais.",
      "insightVenda": "Preço era o entrave; desconto gradual a partir de 8% + workshop funcionou. Curso modelo do portfólio.",
      "wasDerivedFrom": "feq:fonteNotion",
      "descontos": "Alunos e ex-alunos Unicamp/Extecamp têm 10% de desconto.",
      "plataformaAula": "Google Classroom",
      "avaliacaoTexto": "Frequência atestada pela entrega de atividades — presença ao vivo não é obrigatória para aprovação. Atividades avaliativas após cada módulo e Projeto Final de Curso desenvolvido em grupo, em quatro partes ao longo do curso.",
      "salarioRef": "R$ 14.000,00 — referência de mercado para engenharia de processos",
      "objetivosJson": "[{\"t\": \"Tornar os profissionais diferenciados\", \"d\": \"Qualificação no desenvolvimento de projetos de melhoria e inovação em processos, com capacidade de formular estratégias e implantá-las por meio das ferramentas de Inteligência Artificial mais modernas do mercado.\"}, {\"t\": \"Formação otimizada\", \"d\": \"Integração de fundamentos e prática sob um modelo otimizado de ensino a distância: web-aulas ao vivo com conteúdos práticos e aprofundados para os maiores desafios do mercado atual.\"}]",
      "habilidadesJson": "[\"Engenharia e Simulação de Processos Industriais\", \"Machine Learning e Deep Learning\", \"Sistemas de Controle Inteligente\", \"Ferramentas Computacionais para IA (Python)\", \"Análise Estatística e Processamento de Dados Industriais\", \"Otimização com Algoritmos Genéticos\", \"Modelagem Fuzzy e Aprendizado por Reforço\"]",
      "empresasJson": "[\"EMS\", \"Solvay\", \"3M\", \"Petrobras\", \"Eaton\", \"Buckman\", \"Boehringer\", \"Braskem\"]",
      "depoimentosJson": "[{\"nome\": \"Luiz Octavio\", \"cargo\": \"Engenheiro — Petrobras\", \"texto\": \"Sou engenheiro químico e trabalho com pesquisa e desenvolvimento na indústria de óleo e gás. E tenho visto como cada vez mais o mercado de trabalho demanda que os engenheiros desenvolvam soluções de ciência de dados e IA nas suas posições de trabalho. O curso ensina as principais técnicas de IA trazendo para a realidade da indústria química. Em poucas aulas, já iniciei a aplicação dos conhecimentos no meu trabalho e estudos. O curso é totalmente hands on e imperdível para quem quer aprender programação em Python, análise de dados e IA para a indústria de processos.\"}, {\"nome\": \"Juliana Panizza\", \"cargo\": \"Analista de Projetos Pleno\", \"texto\": \"Eu me formei em dezembro de 2016 e, apesar de ter feito estágio numa indústria química por dois anos, eu fiquei desempregada por um ano após me formar engenheira. Consegui um emprego como técnica, onde trabalhei por três anos. Durante este emprego, eu fiz o curso da Extensão FEQ. Dois meses depois de terminar o curso eu consegui um emprego como analista de projetos! Sinto que minha carreira de fato começou agora. Trabalho numa empresa legal, com um salário bom e com uma promessa de plano de carreira.\"}]",
      "programaDetalheJson": "[{\"t\": \"Engenharia de Processos e a Inteligência Artificial\", \"s\": [\"Introdução: Inteligência Artificial e Indústria 4.0\"]}, {\"t\": \"Ferramentas Computacionais para IA\", \"s\": [\"Introdução ao Python\", \"Instalação e ambientes de programação\", \"Sintaxe\", \"Condicionais e estruturas iterativas\", \"Bibliotecas\"]}, {\"t\": \"Ferramentas Estatísticas para Análise de Dados de Processos\", \"s\": [\"Análise exploratória de dados\", \"Distribuição de dados e amostras\", \"Regressão e predição\", \"Classificação\", \"Aprendizagem de máquinas estatística\", \"Aprendizado não supervisionado\"]}, {\"t\": \"Análise e Simulação de Processos\", \"s\": [\"Introdução\", \"Modelos matemáticos dos sistemas de engenharia\", \"Simulação computacional\", \"Dinâmica e controle no domínio do tempo\", \"Processos multivariáveis\"]}, {\"t\": \"Projeto Final de Curso — Parte I\", \"s\": [\"Formação de equipes\", \"Estudo de viabilidade\", \"Definição do cronograma\", \"Requisitos\", \"Avaliação preliminar das propostas\", \"Orientação teórico-metodológica\"]}, {\"t\": \"Técnicas de Otimização e Algoritmos Genéticos\", \"s\": [\"Conceitos básicos de otimização\", \"Algoritmos de otimização\", \"Otimização multiobjetivo\", \"Algoritmos genéticos\"]}, {\"t\": \"Machine Learning em Processos Industriais\", \"s\": [\"Introdução ao Machine Learning\", \"Classificação\", \"Regressão\", \"Agrupamento\", \"Redução dimensional\", \"Pré-processamento e seleção de modelos\"]}, {\"t\": \"Modelagem e Suporte à Decisão Fuzzy\", \"s\": [\"Introdução à Lógica Fuzzy\", \"Teoria dos Conjuntos Fuzzy\", \"Variáveis e termos linguísticos\", \"Funções de pertinência\", \"Conjunto de Regras Fuzzy\", \"Fuzzificação e Defuzzificação\", \"Auxílio à tomada de decisão\"]}, {\"t\": \"Controle de Processos Industriais com Lógica Fuzzy\", \"s\": [\"Introdução ao controle\", \"Controladores PID\", \"Controladores Fuzzy\", \"Sintonia\"]}, {\"t\": \"Projeto Final de Curso — Parte II\", \"s\": [\"Orientação de escrita e apresentação de resultados\", \"Definição de projetos aplicados em IA\", \"Coleta e pré-processamento de dados\", \"Seleção e implementação de algoritmos\", \"Avaliação e métricas de desempenho\"]}, {\"t\": \"Sistemas Neuro-Fuzzy\", \"s\": [\"Introdução\", \"Modelos matemáticos dos sistemas de engenharia\", \"Simulação computacional\", \"Dinâmica e controle no domínio do tempo\", \"Processos multivariáveis\"]}, {\"t\": \"Deep Learning em Processos Industriais\", \"s\": [\"Introdução ao Deep Learning\", \"Redes Neurais Artificiais\", \"Redes Neurais Profundas\", \"Redes Neurais Convolucionais\", \"Redes Recorrentes\"]}, {\"t\": \"Projeto Final de Curso — Parte III\", \"s\": [\"Elaboração e análise do projeto\", \"Orientação para escrita\", \"Implementação de modelos com frameworks populares\", \"Ética e considerações legais em IA\", \"Apresentação preliminar e documentação\"]}, {\"t\": \"Aprendizado por Reforço (Reinforcement Learning)\", \"s\": [\"Conceitos fundamentais e terminologia\", \"Processo de Decisão de Markov (MDP)\", \"Q-Learning, SARSA, Policy Gradient, DDPG\", \"Exploração e explotação\", \"Funções de valor, políticas e modelagem\", \"Aplicações em processos industriais e tomada de decisões\"]}, {\"t\": \"Processamento de Linguagem Natural (NLP)\", \"s\": [\"Conceitos, desafios e aplicações\", \"Pré-processamento de texto (tokenização, stop words, stemming)\", \"Análise sintática e semântica\", \"Embeddings: Word2Vec, GloVe, BERT\", \"Classificação de texto e sentimentos\", \"Geração de texto e sumarização\", \"NLP em chatbots e assistentes virtuais\"]}, {\"t\": \"Projeto Final de Curso — Parte IV\", \"s\": [\"Orientação final\", \"Material para a defesa pública\", \"Definição de avaliadores\", \"Sessões de apresentações orais\"]}]"
    },
    {
      "@id": "feq:FEQ-1000",
      "@type": "feq:Especializacao",
      "codigo": "FEQ-1000",
      "nome": "Engenharia de Processos Químicos",
      "modalidade": "A distância (Online — Google Meet + Moodle)",
      "horarioAula": "aulas teóricas ao vivo aos sábados, das 9h às 12h",
      "formatoAulasResumo": "Teoria ao vivo aos sábados de manhã (9h-12h); tarde assíncrona",
      "formatoAulasDetalhe": "As aulas teóricas ao vivo acontecem aos sábados pela manhã, das 9h às 12h. A tarde é dedicada à resolução de cases e exercícios, que NÃO exigem presença síncrona — o aluno faz no seu ritmo. O formato é pensado para que até quem tem uma rotina bastante corrida consiga acompanhar.",
      "professorResponsavel": "Osvaldir Pereira Taranto",
      "professoresAdicionais": [
        "Dirceu Noriler",
        "Edneu Jatkoski (Petrobras)",
        "Eduardo de Britto Perez",
        "Flavio Vasconcelos da Silva",
        "Guilherme Jose de Castilho",
        "João Lameu da Silva Júnior",
        "Leonardo Vasconcelos Fregolente",
        "Mariana Conceicao da Costa",
        "Raphael Soeiro Suppino",
        "Sérgio D Amore Filho",
        "Victorio Gomieiro Neto"
      ],
      "requisito": {
        "@type": "feq:RequisitoAcademico",
        "nivelMinimo": "feq:superiorCompleto"
      },
      "cargaHoraria": {
        "@type": "feq:Duracao",
        "horas": 448
      },
      "vagasMin": 46,
      "vagasMax": 90,
      "janelaInscricao": {
        "@type": "feq:JanelaTemporal",
        "inicio": "2026-02-20",
        "fim": "2026-08-05"
      },
      "janelaOferecimento": {
        "@type": "feq:JanelaTemporal",
        "inicio": "2026-09-05",
        "fim": "2028-06-24"
      },
      "planoPagamento": {
        "@type": "feq:PlanoPagamento",
        "taxaInscricao": "69.00",
        "numParcelas": 20,
        "valorParcela": "892.81",
        "aVista": "17856.13"
      },
      "urlExtecamp": "https://ins.extecamp.unicamp.br/curso/dados/FEQ-1000/018",
      "objetivo": "Formar o Engenheiro de Processos referência da próxima década, com repertório técnico e administrativo para gerir os processos de grandes empresas, integrando conhecimentos técnicos e habilidades gerenciais para realizar e gerir projetos e processos da indústria.",
      "conteudoProgramatico": "(1) Introdução aos Processos Químicos (balanços de massa/energia, conversões, eficiências); (2) Relações Termodinâmicas e Equilíbrio de Fases; (3) Transferência de Quantidade de Movimento (Navier-Stokes, escoamentos, tubulações); (4) Escoamento de Fluidos não Newtonianos; (5) Dimensionamento de Bombas e Compressores (NPSH, potências); (6) Fluidização, Ciclones e Transporte Pneumático; (7) Engenharia das Reações Químicas (reatores, modelagem); (8) Trocadores de Calor (análise pinch); (9) Avaliação Econômica de Processos e Gestão de Projetos (VPL, TIR, ROI); (10) Controle e Instrumentação (sensores, PLCs, sintonia, preditivos); (11) Processos de Separação (destilação, extração, absorção); (12) Vasos, Tanques e Materiais; (13) Utilidades da Indústria Química (água, vapor, co-geração, ar comprimido); (14) Gerenciamento de Risco de Processo (HAZOP, FMEA); (15) Dispositivos de Segurança e NR 13; (16) Elementos de Refinação e Petroquímica; (17) Projeto Final do Curso.",
      "insightVenda": "Vende-se sozinho (maior histórico). Cadência informativa para controlar volume (vaga máx. 90).",
      "wasDerivedFrom": "feq:fonteNotion",
      "descontos": "Alunos e ex-alunos Unicamp/Extecamp têm 10% de desconto.",
      "plataformaAula": "Google Classroom",
      "garantia7dias": "true",
      "avaliacaoTexto": "Frequência atestada pela entrega de atividades — presença ao vivo não é obrigatória. Atividades avaliativas após cada módulo e Projeto Final de Curso (PFC) desenvolvido em grupo sob orientação do coordenador.",
      "salarioRef": "R$ 12.000,00 — Glassdoor, Engenharia de Processos Químicos",
      "objetivosJson": "[{\"t\": \"Tornar os alunos referências\", \"d\": \"Construção do Engenheiro de Processos referência da próxima década: o profissional com todo o repertório técnico-administrativo para gerir os processos de grandes empresas do futuro.\"}, {\"t\": \"Atualização profissional com formação integrada\", \"d\": \"Integrar conhecimentos técnicos e habilidades gerenciais para realizar e gerir projetos e processos da indústria, com as ferramentas mais recentes do mercado e da academia.\"}]",
      "habilidadesJson": "[\"Balanços de massa e energia em processos químicos\", \"Dimensionamento de bombas, compressores e trocadores de calor\", \"Modelagem e controle de processos industriais\", \"Sistemas de separação: destilação, extração e absorção\", \"Simulação de processos em softwares específicos\", \"Avaliação econômica de projetos (VPL, TIR, ROI)\", \"Gerenciamento de riscos: HAZOP e FMEA\", \"Seleção de materiais e especificação de equipamentos\", \"Utilidades industriais e integração energética\", \"Projeto final aplicado na área química\"]",
      "empresasJson": "[\"EMS\", \"Solvay\", \"3M\", \"Petrobras\", \"Buckman\", \"Braskem\"]",
      "depoimentosJson": "[{\"nome\": \"Edson Papassídero\", \"cargo\": \"Instrutor de Educação Profissional\", \"texto\": \"Tive a grata satisfação de ser aluno da Extensão FEQ Unicamp, onde encontrei Grandes Mestres e Grandes Profissionais. O Curso superou minhas expectativas, inclusive quanto às capacidades que pude agregar em minha trajetória profissional. Uma de minhas metas era me qualificar para a docência e no ano de 2022 fui selecionado pelo SENAI. Desde então estou desempenhando com muito orgulho esta nova atividade profissional. Agradeço de coração por todo o cuidado e carinho de TODOS os envolvidos na oferta do curso.\"}, {\"nome\": \"Juliana Panizza\", \"cargo\": \"Analista de Projetos Pleno\", \"texto\": \"Eu me formei em dezembro de 2016 e, apesar de ter feito estágio numa indústria química por dois anos, eu fiquei desempregada por um ano após me formar engenheira. Consegui um emprego como técnica, onde trabalhei por três anos. Durante este emprego, eu fiz o curso da Extensão FEQ. Dois meses depois de terminar o curso eu consegui um emprego como analista de projetos! Sinto que minha carreira de fato começou agora.\"}, {\"nome\": \"Luiz Octavio\", \"cargo\": \"Engenheiro — Petrobras\", \"texto\": \"O curso é totalmente hands on e imperdível. Em poucas aulas, já iniciei a aplicação dos conhecimentos no meu trabalho e estudos — o mercado demanda cada vez mais que os engenheiros desenvolvam soluções aplicadas na indústria de processos.\"}]",
      "programaDetalheJson": "[{\"t\": \"Introdução aos Processos Químicos\", \"s\": [\"Balanço para cálculo de capacidade de equipamento\", \"Balanço para rendimentos e conversões\", \"Avaliação de geração de subprodutos\", \"Balanço de energia em processos físicos e químicos\", \"Eficiências energéticas e perdas\"]}, {\"t\": \"Relações Termodinâmicas e Equilíbrio de Fases\", \"s\": [\"Relações P-V-T dos fluidos reais\", \"Produção de trabalho pelo calor\", \"Análise termodinâmica de processos\", \"Equilíbrio líquido-vapor, líquido-líquido e químico\", \"Pacotes termodinâmicos dos simuladores\", \"Aplicações: destilação, extração LL, absorção, destilação azeotrópica e extrativa\"]}, {\"t\": \"Transferência de Quantidade de Movimento\", \"s\": [\"Balanço de massa (diferencial e integral)\", \"Navier-Stokes\", \"Perfis de velocidade, pressão e vazão em escoamento laminar\", \"Perdas de carga e redes de tubulações\", \"Escoamento compressível: estagnação, velocidade do som, Mach\", \"Escoamento isentrópico em bocais\", \"Duto adiabático com atrito\"]}, {\"t\": \"Escoamento de Fluidos não Newtonianos\", \"s\": [\"Fluidos não Newtonianos\", \"Classificação reológica dos materiais\", \"Escoamento de fluidos não Newtonianos\", \"Histerese elástica\"]}, {\"t\": \"Dimensionamento e Seleção de Bombas e Compressores\", \"s\": [\"Tipos, seleção e associação de bombas\", \"Sucção, escorva e NPSH\", \"Fluxo mínimo\", \"Velocidades e potências de motores\", \"Sopradores e compressores\", \"Formas termodinâmicas de compressão\", \"Número de estágios\"]}, {\"t\": \"Fluidização, Ciclones e Transporte Pneumático\", \"s\": [\"Fluidização com gases e líquidos\", \"Queda de pressão e mínima fluidização\", \"Expansão de leito fluidizado\", \"Velocidade terminal em campo centrífugo\", \"Ciclones\", \"Transporte pneumático horizontal e vertical\"]}, {\"t\": \"Engenharia das Reações Químicas\", \"s\": [\"Reações homogêneas em reatores reais\", \"Catálise por sólidos e sistemas não catalíticos\", \"Projeto de reatores\", \"Leito fixo, multifásicos, Air-Lift e fluidizados\", \"Modelagem, DTR, agitação e mistura\"]}, {\"t\": \"Trocadores de Calor sem Combustão\", \"s\": [\"Permutadores, condensadores e refervedores via software\", \"Placas, tubos retorcidos\", \"Isolamentos quentes e frios\", \"Análise pinch\", \"Vibrações em permutadores\"]}, {\"t\": \"Avaliação Econômica de Processos e Gestão de Projetos\", \"s\": [\"Estimativa de investimento e índices\", \"Custos fixos, variáveis e depreciação\", \"VPL, TIR, payback, ROI e ROE\", \"Impostos e contribuições\", \"Etapas e fases do projeto (FEL, FEED)\", \"Gerenciamento global e fontes de estimativa\"]}, {\"t\": \"Controle e Instrumentação de Processos Químicos\", \"s\": [\"Sensores de pressão, temperatura, nível e fluxo\", \"Simbologia de instrumentos\", \"Válvulas de controle e inversores\", \"CLPs\", \"Funções de transferência e respostas transientes\", \"Sintonia, estabilidade, cascata e preditivos\", \"Controle de destilação e reatores\", \"SDCD e controle wireless\"]}, {\"t\": \"Processos de Separação: Destilação, Extração e Absorção\", \"s\": [\"Métodos multicomponentes e refluxos\", \"Simuladores de processo\", \"Projeto de torres, internos e recheios\", \"Hidráulica de bandejas (Sieve & Glitsch)\", \"Diâmetro, altura e perda de carga\", \"Batch distillation, economia de energia, troubleshooting\", \"Síntese de processos\"]}, {\"t\": \"Vasos, Tanques e Materiais para Equipamentos\", \"s\": [\"Separadores vapor-líquido e líquido-líquido\", \"Dimensionamento mecânico\", \"Tanques: escolha, proteção e emergência\", \"Tubulações, válvulas, purgadores e normas\", \"Testes hidrostáticos e pneumáticos\", \"Materiais para equipamentos\"]}, {\"t\": \"Utilidades da Indústria Química\", \"s\": [\"Captação e condicionamento de águas\", \"Balanço termoelétrico e co-geração\", \"Ciclos de frio e calor\", \"Ar comprimido e gás inerte\", \"Confiabilidade das utilidades\", \"Biomassa e combustíveis alternativos\", \"Integração energética entre plantas\"]}, {\"t\": \"Gerenciamento de Risco de Processo\", \"s\": [\"Histórico de grandes acidentes (case BP 2005)\", \"Perigo e risco; danos pessoais, ambientais e econômicos\", \"APP, HAZOP e FMEA\", \"Análise quantitativa e árvore de falhas\", \"Tolerabilidade, risco individual e social\", \"Seguro, cálculo de risco e prêmio\"]}, {\"t\": \"Dispositivos de Segurança e NR 13\", \"s\": [\"Válvulas de segurança e discos de ruptura\", \"Vent, flare e fire proof\", \"Inertização, pressão e vácuo\", \"Eletricidade estática e aterramento\", \"Geradores, alarmes e intertravamentos\", \"Bacias de emergência e tubulações\", \"NR 13\"]}, {\"t\": \"Elementos de Refinação e Petroquímica\", \"s\": [\"Derivados do petróleo: obtenção e especificações\", \"Processos de refinação\", \"Cadeia petroquímica e valor agregado\", \"Olefinas, oxigenados e nafta\", \"Polietilenos, PVC e polipropileno\", \"Plásticos verdes e biodegradáveis\"]}, {\"t\": \"Projeto Final do Curso (PFC)\", \"s\": [\"Projeto em grupo sob orientação do coordenador ao longo do programa\"]}]"
    },
