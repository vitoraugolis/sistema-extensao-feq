    {
      "@id": "feq:FEQ-0333", "@type": "feq:Extensao", "codigo": "FEQ-0333",
      "nome": "CCUS — Carbon Capture, Utilization and Storage; Module 1: Introduction",
      "modalidade": "Semipresencial — 1º encontro presencial (FEQ, Campinas/SP); demais sábados online",
      "horarioAula": "1º sábado presencial 8h-16h; demais sábados (online) 8h-12h",
      "formatoAulasResumo": "Presencial no 1º encontro + online ao vivo",
      "formatoAulasDetalhe": "Primeiro encontro presencial (FEQ, Campinas/SP); demais encontros online ao vivo aos sábados, das 8h às 12h.",
      "professorResponsavel": "Luis Fernando Mercier Franco",
      "professoresAdicionais": ["Gustavo Doubek", "Sallie Elizabeth Greenberg"],
      "certificacao": "Certificado",
      "publicoAlvo": "Qualquer área de formação; setores industrial e acadêmico, agências reguladoras; participantes nacionais e internacionais.",
      "requisito": { "@type": "feq:RequisitoAcademico", "nivelMinimo": "feq:superiorCompleto" },
      "cargaHoraria": { "@type": "feq:Duracao", "horas": 40, "label": "40h (8h presenciais + 32h EAD)" },
      "vagasMin": 25, "vagasMax": 60,
      "janelaInscricao":   { "@type": "feq:JanelaTemporal", "inicio": "2025-12-03", "fim": "2026-07-19" },
      "janelaOferecimento":{ "@type": "feq:JanelaTemporal", "inicio": "2026-08-01", "fim": "2026-12-19" },
      "planoPagamento": { "@type": "feq:PlanoPagamento", "taxaInscricao": "22.00", "numParcelas": 3, "valorParcela": "1000.12", "aVista": "3000.37" },
      "urlExtecamp": "https://ins.extecamp.unicamp.br/curso/inscricao/FEQ-0333/001",
      "objetivo": "Compreender captura, utilização e armazenamento de carbono (CCUS) e seu papel na mitigação climática e na descarbonização: dominar a cadeia de valor (captura-transporte-utilização-armazenamento de CO₂), tecnologias de captura e aplicações comerciais, o cenário global e brasileiro, e políticas públicas/mercados de carbono. Desenvolve pensamento crítico sobre o tema. Ministrado EM INGLÊS.",
      "conteudoProgramatico": "8 módulos: (1) Mudanças Climáticas e o Papel do CCUS — Acordo de Paris, metas net-zero, por que reduzir emissões não basta; (2) O que é CCUS? — definição, CCS vs CCUS, história da tecnologia; (3) A Cadeia de Valor do CCUS — captura de CO₂ (fontes e tecnologias), transporte (modais e infraestrutura, realidade brasileira), utilização (aplicações comerciais e pesquisas) e armazenamento (geológico, mineralização; potencial do Brasil); (4) Panorama Global do CCUS — projetos em operação/desenvolvimento, países líderes, hubs; (5) Desafios Técnicos do CCUS — principais barreiras no Brasil; (6) CCUS no Brasil — perfil de emissões, prioridades de descarbonização, licenciamento e percepção pública; (7) Desafios e Oportunidades — barreiras técnicas, econômicas, regulatórias e sociais, e oportunidades de inovação e investimento; (8) CCUS e Políticas Públicas — incentivos internacionais, créditos de carbono, mercados voluntários.",
      "insightVenda": "Aulas ministradas EM INGLÊS. São módulos (Module 1), não curso pela metade. Primeiro oferecimento. Início 01/08/2026 (1º encontro presencial na FEQ, Campinas), término 19/12/2026.",
      "wasDerivedFrom": "feq:fonteNotion"
    },
    {
      "@id": "feq:FEQ-0580", "@type": "feq:Extensao", "codigo": "FEQ-0580",
      "nome": "Dominando a Tomada de Decisão: Otimização e Simulação de Processos Industriais com Python",
