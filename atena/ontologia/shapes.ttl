#  Atena · Ontologia FEQ — Shapes SHACL (integridade do catálogo)
#  ---------------------------------------------------------------------------
#  ESCOPO destas shapes: INTEGRIDADE estrutural do catálogo + COERÊNCIA de
#  pagamento. NÃO modelam "janela aberta hoje" nem "lead elegível": isso é
#  inferência de RUNTIME (depende de `hoje` e do lead), feita por consultas
#  SPARQL em atena/ontologia/servico.py — um curso encerrado é dado VÁLIDO,
#  só não é captável. Misturar as duas coisas seria erro de modelagem.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix feq:  <https://feq.unicamp.br/ontologia#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

feq:prefixos
    sh:declare [ sh:prefix "feq" ; sh:namespace "https://feq.unicamp.br/ontologia#"^^xsd:anyURI ] .

# ------------------------------------------------------------------ Curso
feq:CursoShape a sh:NodeShape ;
    sh:targetClass feq:Curso ;
    sh:property [ sh:path feq:codigo ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:nome ; sh:minCount 1 ] ;
    sh:property [ sh:path feq:requisito ; sh:class feq:RequisitoAcademico ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:janelaInscricao ; sh:class feq:JanelaTemporal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:planoPagamento ; sh:class feq:PlanoPagamento ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # cargaHoraria é OPCIONAL: ausência = "não sei" (ex.: FEQ-0499). O Revisor
    # bloqueia (fail-closed) qualquer claim de carga quando o campo está ausente.
    sh:property [ sh:path feq:cargaHoraria ; sh:class feq:Duracao ; sh:maxCount 1 ] .

# ------------------------------------------------------------------ Requisito acadêmico
feq:RequisitoShape a sh:NodeShape ;
    sh:targetClass feq:RequisitoAcademico ;
    sh:property [
        sh:path feq:nivelMinimo ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( feq:medio feq:superiorIncompleto feq:superiorCompleto feq:pos ) ;
        sh:message "nivelMinimo deve ser um NivelEscolaridade conhecido (ordinal)." ] .

# ------------------------------------------------------------------ Janela temporal
feq:JanelaTemporalShape a sh:NodeShape ;
    sh:targetClass feq:JanelaTemporal ;
    sh:property [ sh:path feq:fim ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:inicio ; sh:datatype xsd:date ; sh:maxCount 1 ] ;  # opcional (ex.: 0499)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Janela inválida: inicio posterior ao fim." ;
        sh:prefixes feq:prefixos ;
        sh:select """
            SELECT $this WHERE {
                $this feq:inicio ?i ; feq:fim ?f .
                FILTER( ?i > ?f )
            }""" ] .

# ------------------------------------------------------------------ Plano de pagamento (coerência)
#  Trava que mata a alucinação de parcelas: numParcelas × valorParcela ~= aVista,
#  com tolerância de arredondamento (1 centavo por parcela + 5 centavos).
#  Ex.: "30x R$ 866,09" => 25982,70 != 16455,75 => VIOLA.
feq:PlanoPagamentoShape a sh:NodeShape ;
    sh:targetClass feq:PlanoPagamento ;
    sh:property [ sh:path feq:numParcelas ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ] ;
    sh:property [ sh:path feq:valorParcela ; sh:datatype xsd:decimal ; sh:minCount 1 ] ;
    sh:property [ sh:path feq:aVista ; sh:datatype xsd:decimal ; sh:minCount 1 ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Plano incoerente: numParcelas × valorParcela difere de aVista além da tolerância." ;
        sh:prefixes feq:prefixos ;
        sh:select """
            SELECT $this WHERE {
                $this feq:numParcelas ?n ; feq:valorParcela ?v ; feq:aVista ?av .
                BIND( ABS( (?n * ?v) - ?av ) AS ?erro )
                BIND( (?n * 0.01) + 0.05 AS ?tol )
                FILTER( ?erro > ?tol )
            }""" ] .

# ------------------------------------------------------------------ Promoção (campanha)
#  Uma promoção é um conjunto de OFERTAS alternativas válidas numa janela. Ela não
#  substitui o planoPagamento (preço de tabela), que continua sendo a base sobre a
#  qual o desconto é anunciado.
feq:PromocaoShape a sh:NodeShape ;
    sh:targetClass feq:Promocao ;
    sh:property [ sh:path feq:rotulo ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:janela ; sh:class feq:JanelaTemporal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:ofertas ; sh:minCount 1 ] .

#  Promoção que sobrevive à inscrição é oferta que não pode ser honrada: o lead
#  chega na Extecamp e o preço não existe mais. Trava aqui, não em produção.
feq:PromocaoNaJanelaShape a sh:NodeShape ;
    sh:targetClass feq:Curso ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Promoção termina depois do fim das inscrições do curso." ;
        sh:prefixes feq:prefixos ;
        sh:select """
            SELECT $this WHERE {
                $this feq:promocao ?p ; feq:janelaInscricao ?ji .
                ?p feq:janela ?jp .
                ?jp feq:fim ?fp .
                ?ji feq:fim ?fi .
                FILTER( ?fp > ?fi )
            }""" ] .

#  Mesma trava de coerência do plano de tabela: quando a oferta anuncia parcelas E
#  valor à vista, os dois têm de fechar. Oferta só-parcelada (sem aVista) é válida:
#  é o caso de "19x de R$ 799" cujo à vista cai na outra oferta, com desconto maior.
feq:OfertaShape a sh:NodeShape ;
    sh:targetClass feq:Oferta ;
    sh:property [ sh:path feq:rotulo ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:condicao ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:numParcelas ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:valorParcela ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:aVista ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path feq:percentualDesconto ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 90 ; sh:maxCount 1 ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Oferta incoerente: numParcelas × valorParcela difere de aVista além da tolerância." ;
        sh:prefixes feq:prefixos ;
        sh:select """
            SELECT $this WHERE {
                $this feq:numParcelas ?n ; feq:valorParcela ?v ; feq:aVista ?av .
                BIND( ABS( (?n * ?v) - ?av ) AS ?erro )
                BIND( (?n * 0.01) + 0.05 AS ?tol )
                FILTER( ?erro > ?tol )
            }""" ] .
