# ---- FARO CRM ----
# Chave sk_live_ (idealmente de um usuário membro APENAS do pipeline [FEQ] CRM).
FARO_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FARO_PIPELINE_ID=49d65f66-ec1d-4c10-a5ff-71aef07f9279

# ---- Meta Lead Ads (preencha quando for plugar a Meta) ----
# Token que VOCÊ define e repete no painel de webhooks da Meta (handshake).
META_VERIFY_TOKEN=defina-um-token-secreto-aqui
# Page Access Token para buscar o lead via Graph API.
META_PAGE_TOKEN=

# ---- WhatsApp Business Cloud ----
WHATSAPP_TOKEN=            # token permanente do System User (whatsapp_business_messaging)
PHONE_NUMBER_ID=          # id do número emissor
WHATSAPP_WABA_ID=         # id da WABA — habilita listar status dos templates (aprovados/PENDING) na Central

# ---- Growth Engine (spec 15: pacing + Meta Ads + CAPI) ----
META_ADS_TOKEN=            # token com ads_read + ads_management (leitura/pausa/verba)
META_AD_ACCOUNT_ID=        # act_XXXXXXXXX
META_PIXEL_ID=             # pixel/dataset que recebe os eventos da CAPI
META_CAPI_TOKEN=           # opcional (default: META_ADS_TOKEN)
GROWTH_CPL_MAX=60          # R$/lead — acima disto o adset é pausado (ou sugerido)
GROWTH_SHIFT_PCT=20        # % de verba movida do curso adiantado p/ o atrasado
GROWTH_BUDGET_MIN_CENTS=1000   # piso diário por adset (R$10)
GROWTH_AUTO_APPLY=0        # 1 = aplica pausa/realocação sem aprovação humana
GROWTH_TEST_EVENT_CODE=    # homologação: roteia CAPI p/ Test Events

# ---- Bridge Pages no WordPress (spec 16 §7) ----
WP_URL=                    # ex.: https://seusite.com.br (sem barra final)
WP_USER=                   # usuário WP com Application Password
WP_APP_PASSWORD=           # Application Password (Usuários -> Perfil -> Application Passwords)
ATENA_PUBLIC_URL=          # URL pública do hub (ex.: https://3.218.159.36.sslip.io) -> {{WEBHOOK_URL}} das LPs
GROWTH_WA_NUMERO=551931672313  # número WABA do botão de WhatsApp das LPs (spec 17 §6)

# ---- Cérebro e transcrição (spec 05, 09) ----
# Sem chave nenhuma o sistema NÃO quebra: o cérebro cai no fallback determinístico
# e o transporte roda em dry-run. É assim que se desenvolve sem gastar token.
ANTHROPIC_API_KEY=         # cérebro + passada semântica do Revisor
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=            # Whisper: transcreve os áudios que o lead manda
GOOGLE_API_KEY=            # provedor alternativo do cérebro (dispatch multiprovider)

# ---- Central de Operação (spec 14) ----
# Sem ATENA_USERS a Central sobe em modo bootstrap: operador/operador. Troque antes
# de expor a Central em qualquer rede.
ATENA_USERS=               # nome:senha:papel,nome2:senha2:papel  (papel: operador|supervisor)
ATENA_MASTER=vitor         # dono dos módulos restritos (spec 19) — só ele concede acesso
ATENA_SECRET=              # chave de sessão; se vazia, é gerada e gravada aqui no 1º boot
ATENA_COOKIE_SECURE=0      # 1 em produção (só envia o cookie por HTTPS)
META_APP_SECRET=           # valida X-Hub-Signature-256 dos webhooks da Meta

# ---- Servidor ----
PORT=8080                  # 8090 cérebro v1 · 8095 Central v2
